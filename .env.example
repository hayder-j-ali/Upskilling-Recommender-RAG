# Copy this file to .env and fill in your values.
# Get a key at https://aistudio.google.com/apikey (Gemini API — has a free
# tier, no billing setup required to get started). This is NOT the same as
# an OpenAI key; langchain-google-genai reads GOOGLE_API_KEY automatically.
GOOGLE_API_KEY=...

# Optional overrides
# CHAT_MODEL=gemini-flash-latest
# EMBEDDING_MODEL=models/gemini-embedding-2
# TEMPERATURE=0.2
# TOP_K=10
